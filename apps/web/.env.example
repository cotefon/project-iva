# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed vars to the
# browser bundle.
#
# Use the **anon / publishable** key here, never the service_role key from the
# repo-root .env: everything in this file ships to the browser. The anon key is
# designed to be public; the service_role key bypasses row-level security and
# must stay on the server.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Where the FastAPI service is listening. Must appear in the backend's
# ALLOWED_ORIGINS for the browser to accept the responses.
VITE_API_URL=http://127.0.0.1:8000
